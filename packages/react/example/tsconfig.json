{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@open-pencil/react": ["../src/index.ts"],
      "@open-pencil/core": ["../../core/src/index.ts"],
      "@open-pencil/core/*": ["../../core/src/*"],
      "@open-pencil/core/editor": ["../../core/src/editor/index.ts"],
      "@open-pencil/core/canvas": ["../../core/src/canvas/index.ts"],
      "@open-pencil/core/canvaskit": ["../../core/src/canvaskit.ts"],
      "@open-pencil/core/constants": ["../../core/src/constants.ts"],
      "@open-pencil/core/scene-graph": ["../../core/src/scene-graph/index.ts"],
      "#react/*": ["../src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules", ".next"]
}